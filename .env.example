# ---------------------------------------------------------------------------
# NOVAWEARS environment variables
# Copy this file to .env.local for local development.
# ---------------------------------------------------------------------------

# ---- Database (libSQL / Turso) --------------------------------------------
# Local development: leave both blank. The app falls back to a local SQLite
# file at DATABASE_PATH (below) automatically.
#
# Production (REQUIRED on Vercel): create a free database at
# https://turso.tech, then set:
#   DATABASE_URL=libsql://<your-db-name>-<org>.turso.io
#   DATABASE_AUTH_TOKEN=<token from `turso db tokens create <your-db-name>`>
# A local file cannot be used in production — Vercel's serverless functions
# have a read-only, ephemeral filesystem.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Local-only fallback DB file path, used when DATABASE_URL is not set.
DATABASE_PATH=./data/novawears.db

# ---- Auth -------------------------------------------------------------
# REQUIRED IN PRODUCTION — signs admin login sessions (JWT).
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# One-time admin account created by `npm run db:seed`.
# Change SEED_ADMIN_PASSWORD before running the seed on a real deployment,
# and change it again from a real password field once you add one —
# the current build creates the account via env vars only.
SEED_ADMIN_EMAIL=admin@novawears.pk
SEED_ADMIN_PASSWORD=ChangeMe123!

# ---- Product image uploads (Vercel Blob) -------------------------------
# Local development: leave blank — uploads are written to public/uploads.
# Production (REQUIRED for the admin "Upload Images" feature on Vercel):
# attach a Blob store to your Vercel project (Storage tab → Create →
# Blob). Vercel sets this automatically once attached; you shouldn't need
# to set it by hand.
BLOB_READ_WRITE_TOKEN=

# ---- Email sending (Resend) --------------------------------------------
# Order notifications + contact form. Get an API key at
# https://resend.com/api-keys and verify a sending domain/address there.
# If left blank, emails are skipped and logged — orders still work
# normally, they just won't send email notifications.
RESEND_API_KEY=
EMAIL_FROM=orders@yourdomain.com

# NOTE: The WhatsApp business number and business email are NOT set via
# env vars — they live in the `settings` table and are editable from
# /admin/settings without touching code. Env vars above are only for
# infrastructure secrets.
