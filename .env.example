# ---------------------------------------------------------------------------
# NOVAWEARS environment variables
# Copy this file to .env.local for local development.
# ---------------------------------------------------------------------------

# Database file location (SQLite). Leave as-is for local dev.
DATABASE_PATH=./data/novawears.db

# REQUIRED IN PRODUCTION — signs admin login sessions (JWT).
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# One-time admin account created by `npm run db:seed`.
# Change SEED_ADMIN_PASSWORD before running the seed on a real deployment,
# and change it again from a real password field once you add one —
# the current build creates the account via env vars only.
SEED_ADMIN_EMAIL=admin@novawears.pk
SEED_ADMIN_PASSWORD=ChangeMe123!

# Email sending (order notifications + contact form) via Resend.
# Get an API key at https://resend.com/api-keys and verify a sending
# domain/address there. If left blank, emails are skipped and logged —
# orders still work normally, they just won't send email notifications.
RESEND_API_KEY=
EMAIL_FROM=orders@yourdomain.com

# NOTE: The WhatsApp business number and business email are NOT set via
# env vars — they live in the `settings` table and are editable from
# /admin/settings without touching code. Env vars above are only for
# infrastructure secrets.
